---
import StoreBadges from './StoreBadges.astro';
import PhoneFrame from './PhoneFrame.astro';
---
<section class="hero">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="container hero-inner">
    <div class="hero-content">
      <p class="eyebrow text-accent h-enter h-1">Join the movement</p>
      <h1 class="display hero-title h-enter h-2">Revolutionizing sports education for <span class="text-accent">the next generation.</span></h1>
      <p class="hero-sub h-enter h-3">Upload a clip. Get personalized feedback from a credential-checked coach. Level up — anywhere.</p>
      <div class="h-enter h-4">
        <StoreBadges source="hero" />
      </div>
    </div>
    <div class="hero-visual h-enter h-3">
      <div class="hero-phone hero-phone-back">
        <PhoneFrame screen="messages" sizes="258px" />
      </div>
      <div class="hero-phone hero-phone-front">
        <PhoneFrame screen="video-analysis" sizes="(max-width: 900px) 250px, 298px" priority />
      </div>
      <!-- Small pieces of real app UI; decorative, so hidden from screen readers. -->
      <div class="hero-chip hero-chip-status" aria-hidden="true">
        <span class="hero-chip-label">Video Analysis</span>
        <span class="hero-chip-tag">Complete</span>
      </div>
      <div class="hero-chip hero-chip-msg" aria-hidden="true">
        <span class="hero-avatar">
          <svg width="18" height="18" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4" fill="currentColor"></circle><path d="M4 20c0-4 3.6-6 8-6s8 2 8 6z" fill="currentColor"></path></svg>
        </span>
        <span class="hero-msg">
          <span class="hero-msg-name">Sofia Ramirez</span>
          <span class="hero-msg-text">Thank you! The hip cue made a big difference.</span>
        </span>
      </div>
    </div>
  </div>
</section>
<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(120deg, var(--brand-chrome) 0%, #041c2b 48%, var(--canvas) 100%);
  }
  .hero-glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(700px 420px at 74% 55%, rgba(8,180,182,.16), transparent 65%),
      radial-gradient(520px 320px at 20% 30%, rgba(243,94,10,.07), transparent 60%);
    pointer-events: none;
    z-index: 0;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 40px;
    align-items: center;
    padding: 72px 0;
  }
  /* Sized so the longest word ("Revolutionizing") fits its half-width column. */
  .hero-title {
    font-size: clamp(40px, 5.2vw, 66px);
    margin: 12px 0 20px;
    line-height: 1.0;
  }
  .hero-sub {
    font-size: 19px;
    color: rgba(255,255,255,.84);
    max-width: 480px;
    margin-bottom: 28px;
    line-height: 1.55;
  }

  /* ── app screens: Video Analysis in front, the coach inbox behind ── */
  .hero-visual {
    --front: clamp(230px, 23vw, 298px);
    position: relative;
    height: calc(var(--front) * 2.25 + 40px);
  }
  .hero-phone { position: absolute; }
  .hero-phone-front { --phone-w: var(--front); right: 6%; top: 0; transform: rotate(3deg); z-index: 2; }
  .hero-phone-front :global(.phone) {
    box-shadow: 0 50px 100px -30px rgba(0,0,0,.95), 0 0 140px -30px rgba(8,180,182,.55);
  }
  .hero-phone-back { --phone-w: calc(var(--front) * 0.87); left: 0; top: 12%; transform: rotate(-7deg); opacity: .92; }
  .hero-chip {
    position: absolute;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--surface);
    border: 1px solid rgba(255,255,255,.10);
    border-radius: 14px;
    box-shadow: 0 18px 40px -16px rgba(0,0,0,.9);
  }
  .hero-chip-status { top: -2%; right: -2%; padding: 10px 14px; }
  .hero-chip-label { font-size: 13px; font-weight: 700; }
  .hero-chip-tag {
    padding: 4px 10px; border-radius: 999px;
    background: rgba(8,180,182,.16); color: var(--link); font-size: 12px; font-weight: 800;
  }
  .hero-chip-msg { left: -4%; bottom: 6%; width: 290px; padding: 12px 14px; gap: 12px; }
  .hero-avatar {
    flex-shrink: 0; width: 38px; height: 38px; border-radius: 999px;
    background: #2a1405; color: var(--primary-action);
    display: flex; align-items: center; justify-content: center;
  }
  .hero-msg { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .hero-msg-name { font-size: 14px; font-weight: 800; }
  .hero-msg-text { font-size: 13px; line-height: 1.4; color: var(--on-surface-variant); }

  @media (max-width: 900px) {
    .hero-inner { grid-template-columns: 1fr; gap: 32px; padding: 56px 0 40px; }
    .hero-visual { --front: 250px; height: auto; display: flex; justify-content: center; padding-bottom: 28px; }
    .hero-phone-front { position: static; transform: none; }
    .hero-phone-back, .hero-chip-status { display: none; }
    .hero-chip-msg { left: 0; bottom: 0; width: min(290px, 80%); }
  }

  /* ── staggered entrance keyframe ── */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: none; }
  }
  .h-enter {
    animation: fadeUp .7s cubic-bezier(.16,1,.3,1) both;
  }
  .h-1 { animation-delay: .05s; }
  .h-2 { animation-delay: .15s; }
  .h-3 { animation-delay: .28s; }
  .h-4 { animation-delay: .42s; }

  @media (prefers-reduced-motion: reduce) {
    .h-enter { animation: none; opacity: 1; transform: none; }
  }
</style>
