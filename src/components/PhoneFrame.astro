---
// A real app screen in a phone frame. Size it by setting --phone-w on a parent
// (it inherits); everything else scales from that width. Anything passed as
// children is laid over the screen (positioned in % of the screen).
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { screens, type ScreenKey } from '../data/appScreens';

interface Props {
  screen: ScreenKey;
  /** `sizes` for the responsive image; match the widths the parent sets. */
  sizes: string;
  /** Above-the-fold hero image: load immediately and at high priority. */
  priority?: boolean;
}
const { screen, sizes, priority = false } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/app-screens/*.webp', { eager: true });
const img = files[`../assets/app-screens/${screen}.webp`]?.default;
if (!img) throw new Error(`Missing app screen image for "${screen}" in src/assets/app-screens/`);
---
<div class="phone">
  <div class="phone-screen">
    <Picture
      src={img}
      alt={screens[screen].alt}
      widths={[360, 540, 720]}
      sizes={sizes}
      formats={['avif', 'webp']}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding="async"
    />
    <span class="phone-island" aria-hidden="true"></span>
    <slot />
  </div>
</div>
<style>
  .phone {
    --w: var(--phone-w, 260px);
    width: var(--w);
    box-sizing: border-box;
    padding: calc(var(--w) * 0.032);
    border-radius: calc(var(--w) * 0.165);
    background: #0a0a0f;
    border: 1px solid rgba(255,255,255,.14);
    box-shadow: 0 40px 80px -28px rgba(0,0,0,.95);
  }
  .phone-screen { position: relative; border-radius: calc(var(--w) * 0.133); overflow: hidden; }
  .phone-screen :global(picture) { display: block; }
  .phone-screen :global(img) { display: block; width: 100%; height: auto; }
  .phone-island {
    position: absolute; top: 1.3%; left: 50%; width: 30%; height: 2.4%;
    transform: translateX(-50%); border-radius: 999px; background: var(--canvas);
  }
</style>
