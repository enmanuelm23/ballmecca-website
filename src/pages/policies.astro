---
import BaseLayout from '../layouts/BaseLayout.astro';
const policies = [
  { href: '/privacy-policy', title: 'Privacy Policy', desc: 'What we collect, how we use and share it, children’s privacy, and your privacy choices.' },
  { href: '/terms', title: 'Terms & Conditions', desc: 'Accounts and minors, payments and fees, coach and recruiter conduct, and dispute resolution.' },
  { href: '/returns', title: 'Returns Policy', desc: 'Refunds for coaching sessions and coach subscriptions.' },
  { href: '/acceptable-use', title: 'Acceptable Use Policy', desc: 'The rules for using Ballmecca safely — including youth safety and how to report abuse.' },
  { href: '/cookie-policy', title: 'Cookie Policy', desc: 'The cookies we use and how to change your privacy choices.' },
  { href: '/dmca', title: 'DMCA', desc: 'How to report copyright infringement to our designated agent.' },
  { href: '/disclaimer', title: 'Disclaimer', desc: 'Athletic activity, professional advice, and testimonials.' },
];
---
<BaseLayout title="Policies" description="Ballmecca's privacy policy, terms, and legal information — all in one place." path="/policies">
  <section class="container pol-hub">
    <h1 class="display pol-hub-title">Our policies.</h1>
    <p class="text-muted pol-hub-sub">
      Each policy lives on its own page. Questions?
      <a href="mailto:support@ballmecca.com">support@ballmecca.com</a>
    </p>
    <ul class="pol-list">
      {policies.map((p) => (
        <li class="pol-card">
          <h2 class="pol-card-title"><a href={p.href}>{p.title}</a></h2>
          <p class="text-muted pol-card-desc">{p.desc}</p>
        </li>
      ))}
    </ul>
  </section>
  <script is:inline>
    // Preserve legacy deep links (e.g. /policies#privacy still referenced by the
    // app, the app stores, or old emails) by forwarding to the dedicated page.
    (function () {
      var map = {
        '#privacy': '/privacy-policy', '#terms': '/terms', '#returns': '/returns',
        '#acceptable-use': '/acceptable-use', '#cookie': '/cookie-policy',
        '#dmca': '/dmca', '#disclaimer': '/disclaimer',
      };
      var to = map[window.location.hash];
      if (to) window.location.replace(to);
    })();
  </script>
</BaseLayout>
<style>
  .pol-hub { padding: 48px 0 80px; }
  .pol-hub-title { font-size: clamp(34px, 6vw, 44px); }
  .pol-hub-sub { margin-top: 8px; }
  .pol-list { list-style: none; padding: 0; margin: 28px 0 0; display: grid;
    grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .pol-card { background: var(--surface); border: 1px solid var(--border);
    border-left: 3px solid var(--link); border-radius: var(--radius-md); padding: 20px 22px; }
  .pol-card-title { font-family: var(--font-display); font-size: 20px; margin: 0; }
  .pol-card-title a { color: var(--on-surface); text-decoration: none; }
  .pol-card-title a:hover { color: var(--link); text-decoration: underline; }
  .pol-card-desc { font-size: 14px; line-height: 1.6; margin: 6px 0 0; }
  @media (max-width: 700px) { .pol-list { grid-template-columns: 1fr; } }
</style>
